# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# On Render these go in Environment, not in code (spec §10).

# ── Microsoft Graph (mailbox OAuth) ──
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://blam8.haail.dev/oauth/callback
AZURE_TENANT_ID=common            # 'common' for a multi-tenant Microsoft app

# ── Google (Gmail) mailbox OAuth — second provider (see README for Cloud setup) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://blam8.haail.dev/oauth/google/callback
# Flip to true the moment Google verification clears — lifts the Gmail-connect
# invite gate and hides the "X of 100 Gmail connections left" indicator (the
# 100-cap on restricted-scope grants only applies while unverified).
GOOGLE_OAUTH_VERIFIED=false
# ── Supabase ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=             # service role — server-side only, bypasses RLS
SUPABASE_ANON_KEY=                # dashboard (browser) auth

# ── Anthropic (drafting) ──
ANTHROPIC_API_KEY=

# ── OpenAI (Whisper transcription — founder Voice CRM at /admin/voice-crm only) ──
OPENAI_API_KEY=

# Speech worker for all Blam8 users (docs/operations/local-speech.md).
# Keep openai until the worker has been deployed and tested. No automatic fallback.
SPEECH_PROVIDER=openai
SPEECH_SERVICE_URL=              # https://speech.your-domain.example
SPEECH_SERVICE_WS_URL=           # wss://speech.your-domain.example/v1/realtime
SPEECH_SERVICE_KEY=              # matches worker SPEECH_API_KEY; never sent to browsers

# ── Embeddings provider (knowledge base retrieval) — Voyage AI ──
VOYAGE_API_KEY=                   # voyage-3, 1024-dim (see README). Leave blank to disable the knowledge base.

# ── App ──
APP_BASE_URL=http://localhost:8000
GRAPH_WEBHOOK_SECRET=             # clientState used to validate inbound Graph notifications

# ── Security ──
# Fernet key for token-at-rest encryption. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
EMAIL_RETENTION_DAYS=90           # redact email_log bodies older than this many days
CSP_ENFORCE=false                 # false => Content-Security-Policy-Report-Only (flip to true after validating)

# ── Stripe billing ──
# Hosted Checkout + Customer Portal (no Stripe.js, so no CSP changes).
# Use TEST keys (sk_test_..., whsec_...) locally; LIVE keys go in Render only.
STRIPE_SECRET_KEY=                # sk_test_... / sk_live_...  (server-side only)
STRIPE_PUBLISHABLE_KEY=           # pk_test_... / pk_live_...  (currently unused — kept for future Elements use)
STRIPE_WEBHOOK_SECRET=            # whsec_...  (Dashboard → Developers → Webhooks → signing secret)
# Price IDs from the Stripe Dashboard (Products → Pricing). One per tier/add-on.
STRIPE_EMAIL_PRICE_ID=            # BLAM8 Email — £39/mo
STRIPE_STARTER_PRICE_ID=          # BLAM8 Core — £99/mo
STRIPE_OS_PRICE_ID=               # BLAM8 Core + your OS — £248/mo (£99 + £149; every OS except Transport)
STRIPE_PROFESSIONAL_PRICE_ID=     # BLAM8 Core + Field OS · Transport — £298/mo (£99 + £199)
STRIPE_EXTRA_MAILBOX_PRICE_ID=    # Extra mailbox add-on — £39/mailbox/mo
STRIPE_EXTRA_DEPOT_PRICE_ID=      # Additional depot add-on — £149/depot/mo (includes its mailbox + 1,000 emails)
STRIPE_SCALE_PRICE_ID=            # BLAM8 Scale — £799/mo (RETIRED 2026-07-11; keeps a legacy subscription resolving)
STRIPE_ENTERPRISE_PRICE_ID=       # may stay blank — enterprise is invoice-billed, not self-serve
TRIAL_DAYS=14                     # free trial length (days) — also the app-side trial window

# ── Stripe Connect (tenant invoicing "Pay Now") ──
# Tenants connect their OWN Stripe account via OAuth; invoice payments land in THEIR
# Stripe (BLAM8 takes no cut). The platform STRIPE_SECRET_KEY above makes the API
# calls with stripe_account=acct_…. Blank client id == Pay Now off (invoices fall
# back to the tenant's bank-transfer details).
STRIPE_CONNECT_CLIENT_ID=         # ca_… — Dashboard → Settings → Connect → Integration
STRIPE_CONNECT_WEBHOOK_SECRET=    # whsec_… for the /webhooks/stripe endpoint ("Listen to Connected accounts")

# ── Access gate (trial lock) ──
# When true: require_subscription enforces on the /app dashboard AND the drafting
# pipeline stops once a tenant's free trial is over (14 days OR TRIAL_EMAIL_CAP
# emails). Default false keeps the trial open-ended (the launch state). Stripe
# CHARGING is separate — this only gates access + the upgrade CTA.
REQUIRE_SUBSCRIPTION_GATE=false
# Free-trial email allowance (well below the Core tier's 1,000/mo — a taste, not
# a free ride). Retune from the Render dashboard without a redeploy.
TRIAL_EMAIL_CAP=100

# Native GPT-Live mode; independent of Standard speech provider. Default off.
GPTLIVE_ENABLED=false
# What new speech may stop a GPT-Live business turn that is still working. Two values:
#   cue_words  (default) only a correction or stop cue ("no, not ...", "wait", "never mind",
#              "stop") or a new request the model raises; background talk is held, not acted on
#   any_words  the previous behaviour: every heard fragment stops the working turn
# Case and surrounding spaces do not matter; any other value falls back to cue_words with a
# logged warning (a typo here must not stop the app starting).
GPTLIVE_INTERRUPT_RULE=cue_words

# GPT-Live idle close: end a live conversation that has been idle this many seconds (nobody
# speaking, nothing working, nothing waiting to be spoken; a muted microphone counts as idle),
# so it stops billing live-voice minutes. The screen warns 10 seconds before; a tap or any
# speech keeps it open; while a card or draft is waiting for the owner's Confirm the time
# allowed is doubled. 0 = never close for idleness. Whole seconds; anything else logs a
# warning and uses 60 (a typo here must not stop the app starting).
GPTLIVE_IDLE_CLOSE_SECONDS=60

# GPT-Live settle wait, in milliseconds: once the model raises a request, the server waits until
# the owner has been silent this long before it takes the words heard as the request, so a
# pause inside one request ("... can you just bin it? [pause] Or change it to two hundred quid")
# is not taken as its end. Longer absorbs longer pauses and adds that much latency to every
# delegated request (the default 1000 is about 0.4 s slower than the old fixed 600). The whole
# wait for a request's words is 3 s, or this plus 2.4 s if that is longer, so words that arrive
# after their delegation keep their headroom at any setting. Whole milliseconds, 300-2500
# (outside that is clamped with a warning); anything else logs a warning and uses 1000
# (a typo here must not stop the app starting).
GPTLIVE_SETTLE_MS=1000

# Process memory read-out: one log line of resident memory and in-process store sizes every N seconds
# (minimum 15; 0 = off). The same numbers are always at /admin/memstat for an operator.
MEMSTAT_SECONDS=0

# Simulated telephone pilot: disabled by default; no live carrier adapter.
TELEPHONE_PILOT_ENABLED=false
TELEPHONE_PILOT_PROVIDER=simulated
# Required for signed simulated callback events; never reuse a production secret.
TELEPHONE_PILOT_WEBHOOK_SECRET=

# Real telephone transport remains off until an explicitly authorised carrier trial.
# Existing TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN and OPENAI_API_KEY are reused.
# Canonical externally reachable HTTPS base, never inferred from request Host.
TELEPHONE_LIVE_ENABLED=false
TELEPHONE_WEBHOOK_BASE_URL=
TELEPHONE_REALTIME_MODEL=
TELEPHONE_OPENAI_PROJECT_ID=
TELEPHONE_OPENAI_WEBHOOK_SECRET=
